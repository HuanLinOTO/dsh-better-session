# 三个脚本都是 TS，一律用 `pnpm dlx @oxc-node/cli` 直跑（oxc transformer + resolver）；
# 不用 tsx（没被任何清单声明过），也不写 `node --import=…`。
skill := join(module_directory(), '../.agents/skills/dsh-plugin-upstream-sync/scripts')

sync:
    pnpm dlx @oxc-node/cli {{ skill }}/sync.ts

patch:
    pnpm dlx @oxc-node/cli {{ skill }}/patch.ts

prebuild:
    pnpm dlx @oxc-node/cli {{ skill }}/prebuild.ts
